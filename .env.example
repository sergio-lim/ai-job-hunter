# Optional runtime settings. Copy values into your shell; do not commit secrets.
# None of these are required for `python -m jobhunter run --demo`.

# LLM_API_KEY          OpenAI-compatible secret (classify --llm only)
# LLM_BASE_URL         default https://api.openai.com/v1
# LLM_MODEL            default gpt-4o-mini
# TELEGRAM_BOT_TOKEN   bot token from BotFather
# TELEGRAM_CHAT_ID     numeric chat destination
# GREENHOUSE_BOARDS    comma-separated public board slugs (default: gitlab)
